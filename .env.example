APP_NAME=Expense Intelligence
DEBUG=false

# --- AI: choose one ---

# Option A: Groq (cloud, free) — recommended for deployment
# Get a free key at https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Option B: Ollama (local) — used automatically if GROQ_API_KEY is empty
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_PRIMARY_MODEL=qwen3:8b
OLLAMA_FALLBACK_MODEL=qwen3:4b
OLLAMA_TIMEOUT=120
OLLAMA_MAX_RETRIES=3

MAX_UPLOAD_SIZE_MB=50
